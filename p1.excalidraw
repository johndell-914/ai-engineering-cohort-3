      "version": 330,
      "versionNonce": 1128565619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751302532948,
      "link": null,
      "locked": false,
      "text": "<response>\n1. Eat a balanced diet and make sure to include plenty of fruits and vegetables.\n2. Exercise regularly to keep your body active and strong.\n3. Get enough sleep and maintain a consistent sleep schedule.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<response>\n1. Eat a balanced diet and make sure to include plenty of fruits and vegetables.\n2. Exercise regularly to keep your body active and strong.\n3. Get enough sleep and maintain a consistent sleep schedule.",
      "autoResize": true,
      "lineHeight": 1.25
    },
