      "id": "wdoHqjWdEPOHBjXh3Odfd",
      "type": "text",
      "x": 2207.6852518858404,
      "y": 1282.969979722142,
      "width": 781.199462890625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
