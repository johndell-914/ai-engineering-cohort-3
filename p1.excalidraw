      "text": "RL Goal: generate responses that are preferred by humans\n\n(correct, accurate, safe, helpful, polite, etc.)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RL Goal: generate responses that are preferred by humans\n\n(correct, accurate, safe, helpful, polite, etc.)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EAwUCnVIorjRaiSCtxJGP",
      "type": "text",
      "x": 4114.439815095602,
      "y": 2192.182693331055,
      "width": 552.7811754014754,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bC0",
      "roundness": null,
      "seed": 1928450353,
      "version": 1232,
      "versionNonce": 1068201096,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751395934680,
      "link": null,
      "locked": false,
      "text": "Start with a solid foundation in Python, linear algebra,\nprobability, and statistics, then take a beginner-friendly\nML course like Andrew Ng’s on Coursera. Practice by\nbuilding small projects and exploring real datasets.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Start with a solid foundation in Python, linear algebra, probability, and statistics, then take a beginner-friendly ML course like Andrew Ng’s on Coursera. Practice by building small projects and exploring real datasets.",
      "autoResize": false,
      "lineHeight": 1.25
    },
