      "type": "text",
      "x": -2748.9509196378517,
      "y": 12171.955695539224,
      "width": 842.2194213867188,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
