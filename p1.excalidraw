    },
    {
      "id": "zTCFSAQsMCXng86eiiUFs",
      "type": "text",
      "x": 8313.63780624872,
      "y": 5792.405156941443,
      "width": 555.489624023438,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEl",
      "roundness": null,
      "seed": 1648915185,
      "version": 421,
      "versionNonce": 958392568,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "YNIXbbLOb7EyBtwG8fFKd",
          "type": "arrow"
        }
      ],
      "updated": 1751396024814,
      "link": null,
      "locked": false,
      "text": "Start with a solid foundation in Python, linear algebra,\nprobability, and statistics, then take a beginner-friendly\nML course like Andrew Ng’s on Coursera. Practice by\nbuilding small projects and exploring real datasets.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Start with a solid foundation in Python, linear algebra, probability, and statistics, then take a beginner-friendly ML course like Andrew Ng’s on Coursera. Practice by building small projects and exploring real datasets.",
      "autoResize": false,
      "lineHeight": 1.25
    },
