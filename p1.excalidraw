      "text": "I want to learn ML.\nwhat shoud I do?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I want to learn ML. what shoud I do?",
