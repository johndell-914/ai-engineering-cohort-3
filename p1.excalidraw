      "seed": 1832006837,
      "version": 173,
      "versionNonce": 341289105,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751126187321,
      "link": null,
      "locked": false,
      "text": "Temperature is a parameter to control the randomness of predictions during sampling. \nTemperature parameter T scales the logits (raw scores) of the model’s output \nbefore applying the softmax function to generate probabilities.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Temperature is a parameter to control the randomness of predictions during sampling. \nTemperature parameter T scales the logits (raw scores) of the model’s output \nbefore applying the softmax function to generate probabilities.",
      "autoResize": true,
      "lineHeight": 1.25
    },
