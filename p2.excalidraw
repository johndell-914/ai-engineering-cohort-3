    {
      "id": "-qOLZqWo92GKEYZaCeoWN",
      "type": "text",
      "x": -695.4921430266176,
      "y": 12341.330844287428,
      "width": 662.9196166992188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNO",
      "roundness": null,
      "seed": 159786169,
      "version": 193,
      "versionNonce": 1787340759,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752261968857,
      "link": null,
      "locked": false,
      "text": "If retrieval quality is not good, LLM will generate suboptimal output",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If retrieval quality is not good, LLM will generate suboptimal output",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TzBgnxPoHm0WRQSGEkwMP",
      "type": "text",
      "x": -17.661506865902993,
      "y": 12342.862884838023,
      "width": 750.739501953125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNQ",
      "roundness": null,
      "seed": 808834679,
      "version": 256,
      "versionNonce": 619943159,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752261968857,
      "link": null,
      "locked": false,
      "text": "===> finetune LLM to distingyuish between relevant and irrelevant documents",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "===> finetune LLM to distingyuish between relevant and irrelevant documents",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_2XjuLkqMBzmVv4IIapsy",
      "type": "text",
      "x": -696.01762665757,
      "y": 12866.80540715945,
      "width": 920.599365234375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNR",
      "roundness": null,
      "seed": 1308513431,
      "version": 233,
      "versionNonce": 1774444055,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752261968857,
      "link": null,
      "locked": false,
      "text": "During finetuning, the LLM is trained to generate responses based on the relevant documents \nwhile minimizing the influence of irrelevant documents",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "During finetuning, the LLM is trained to generate responses based on the relevant documents \nwhile minimizing the influence of irrelevant documents",
      "autoResize": true,
      "lineHeight": 1.25
    },
