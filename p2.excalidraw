    {
      "id": "7mZX9jAaS0ZfgaF2PJ81s",
      "type": "text",
      "x": -333.84112175771895,
      "y": 2850.1450690498464,
      "width": 1055.0674845377603,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIr",
      "roundness": null,
      "seed": 875099717,
      "version": 317,
      "versionNonce": 1771564645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752163136485,
      "link": null,
      "locked": false,
      "text": "1. Adapters: add a small trainable module inside each transformer layer\n2. LoRA: add a low-rank matrix to linear layers\n2. Prompt/Prefix tuning: learn extra embeddings (virtual tokens) instead of inserting new sub-networks.\n3. Activation scalers: add three scaling vectors per layer\n4. Bias-only: Just fine-tune existing bias terms; no new parameters are inserted.\n5. Sparse weight deltas: learn a sparse mask of weight differences on top of the frozen weights",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Adapters: add a small trainable module inside each transformer layer\n2. LoRA: add a low-rank matrix to linear layers\n2. Prompt/Prefix tuning: learn extra embeddings (virtual tokens) instead of inserting new sub-networks.\n3. Activation scalers: add three scaling vectors per layer\n4. Bias-only: Just fine-tune existing bias terms; no new parameters are inserted.\n5. Sparse weight deltas: learn a sparse mask of weight differences on top of the frozen weights",
      "autoResize": false,
      "lineHeight": 1.25
    },
