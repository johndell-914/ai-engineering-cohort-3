      "text": "Sectioning: Breaking a task into independent subtasks run in parallel.\nVoting: Running the same task multiple times to get diverse outputs.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sectioning: Breaking a task into independent subtasks run in parallel.\nVoting: Running the same task multiple times to get diverse outputs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
