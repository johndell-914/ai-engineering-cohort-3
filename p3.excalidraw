    {
      "id": "8sd70DDKadJkJRS4bsfGB",
      "type": "text",
      "x": 6366.861729881946,
      "y": 3785.5277083285055,
      "width": 540.4996948242188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
