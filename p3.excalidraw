    {
      "id": "B1gz8wF7gxMNHx7y9kfF6",
      "type": "text",
      "x": 12377.702072291127,
      "y": 991.4869418464691,
      "width": 450.4862583705354,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bct",
      "roundness": null,
      "seed": 661237099,
      "version": 1663,
      "versionNonce": 7455525,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753113515328,
      "link": null,
      "locked": false,
      "text": "You can use a tool called add to add two\nnumbers. It takes two inputs: number 1 and\nnumber 2. It returns their sum. Use it like this:\n\n<tool>\nadd(n1, n2)\n</tool>\n\nJust replace n1 and n2 with the numbers you\nwant to add.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You can use a tool called add to add two numbers. It takes two inputs: number 1 and number 2. It returns their sum. Use it like this:\n\n<tool>\nadd(n1, n2)\n</tool>\n\nJust replace n1 and n2 with the numbers you want to add.",
      "autoResize": false,
      "lineHeight": 1.25
    },
