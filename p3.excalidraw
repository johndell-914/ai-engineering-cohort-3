      "seed": 1053618315,
      "version": 161,
      "versionNonce": 378138731,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753047479984,
      "link": null,
      "locked": false,
      "text": "Code generation: \n    - Evaluator run tests and identifies errors\n    - Generator write code and fixed errors",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Code generation: \n    - Evaluator run tests and identifies errors\n    - Generator write code and fixed errors",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NoNWSzTnIHHyUgX1tfPW0",
      "type": "text",
      "x": 7959.029791641919,
      "y": 6355.178706424358,
      "width": 693.6595458984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bn6",
      "roundness": null,
      "seed": 1123531045,
      "version": 308,
      "versionNonce": 2093820139,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753047681955,
      "link": null,
      "locked": false,
      "text": "Creating Detailed Plans: requires planning and strategy.\n    - Evaluator decides if a proposed plan has flaws or can be improved\n    - Generator improves the plan based on the feedback",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Creating Detailed Plans: requires planning and strategy.\n    - Evaluator decides if a proposed plan has flaws or can be improved\n    - Generator improves the plan based on the feedback",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cPEa_z2acEvVcUDZRfvuw",
      "type": "text",
      "x": 7959.796393204419,
      "y": 6191.718745486858,
      "width": 854.0140380859376,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bn7",
      "roundness": null,
      "seed": 1630301387,
      "version": 192,
      "versionNonce": 592608005,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753047578671,
      "link": null,
      "locked": false,
      "text": "Complex search tasks: require multiple rounds of searching and analysis.\n    - Evaluator decides whether further searches are needed\n    - Generator performs more searches and collects more information",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Complex search tasks: require multiple rounds of searching and analysis.\n    - Evaluator decides whether further searches are needed\n    - Generator performs more searches and collects more information",
      "autoResize": false,
      "lineHeight": 1.25
    },
