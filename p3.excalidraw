      "seed": 589661195,
      "version": 317,
      "versionNonce": 1882705483,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753207940276,
      "link": null,
      "locked": false,
      "text": "Structured information synthesis: generating a complex output like a research report",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Structured information synthesis: generating a complex output like a research report",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q4euQNZW7XD_R7b-c-8Mj",
      "type": "text",
      "x": 15806.711962568825,
      "y": 4084.772226342322,
      "width": 588.8392333984375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brx",
      "roundness": null,
      "seed": 596560555,
      "version": 1143,
      "versionNonce": 708442123,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753207846709,
      "link": null,
      "locked": false,
      "text": "workflows offer predictability and consistency for well-\ndefined tasks, whereas agents are the better option when\nflexibility and model-driven decision-making are needed at\nscale.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "workflows offer predictability and consistency for well-defined tasks, whereas agents are the better option when flexibility and model-driven decision-making are needed at scale.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "FLoouq5o4lFVBcD8HfV8h",
      "type": "text",
      "x": 15798.867891769227,
      "y": 4288.903338759459,
      "width": 618.3243408203125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bry",
      "roundness": null,
      "seed": 1616264523,
      "version": 338,
      "versionNonce": 1394381451,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753207866259,
      "link": null,
      "locked": false,
      "text": "Agents can adapt to new situations, like answering a\ncustomer’s unique question. Workflows are rigid, better for\nrepeating the same process, like scheduling maintenance.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agents can adapt to new situations, like answering a customer’s unique question. Workflows are rigid, better for repeating the same process, like scheduling maintenance.",
      "autoResize": false,
      "lineHeight": 1.25
    },
