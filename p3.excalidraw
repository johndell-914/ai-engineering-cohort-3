      "isDeleted": false,
      "boundElements": null,
      "updated": 1753207423947,
      "link": null,
      "locked": false,
      "text": "proposing a modular paradigm ReWOO (Reasoning\nWithOut Observation) that detaches the reasoning process from external observations",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "proposing a modular paradigm ReWOO (Reasoning\nWithOut Observation) that detaches the reasoning process from external observations",
      "autoResize": true,
      "lineHeight": 1.25
    },
