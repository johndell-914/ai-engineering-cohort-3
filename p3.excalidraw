      "seed": 1959727403,
      "version": 501,
      "versionNonce": 1567122059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753030154930,
      "link": null,
      "locked": false,
      "text": "The output of one step is the input for the next step",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The output of one step is the input for the next step",
      "autoResize": true,
