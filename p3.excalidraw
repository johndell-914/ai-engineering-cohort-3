      "updated": 1753207934676,
      "link": null,
      "locked": false,
      "text": "When to use multi-step agents",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When to use multi-step agents",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Axd4SrfLkm4T7UTTEsqUL",
      "type": "text",
      "x": 17473.79597499345,
      "y": 4349.899154968847,
      "width": 1016.2089843749998,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brp",
      "roundness": null,
      "seed": 624911787,
      "version": 366,
      "versionNonce": 2009125611,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753207942876,
      "link": null,
      "locked": false,
      "text": "Agents can be used for open-ended problems where it’s difficult to predict the required number of\nsteps, and where you can’t hardcode a fixed path",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agents can be used for open-ended problems where it’s difficult to predict the required number of steps, and where you can’t hardcode a fixed path",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5C_HPmWAnLLzY7rsoykZz",
      "type": "text",
      "x": 17458.20222499345,
      "y": 4068.721420593847,
      "width": 949.7193603515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brq",
      "roundness": null,
      "seed": 926644299,
      "version": 325,
      "versionNonce": 698170763,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753207942876,
      "link": null,
      "locked": false,
      "text": "The autonomous nature of agents means higher costs, and the potential for compounding errors.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The autonomous nature of agents means higher costs, and the potential for compounding errors.",
      "autoResize": true,
      "lineHeight": 1.25
    },
