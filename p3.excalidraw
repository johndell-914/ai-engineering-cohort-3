      "boundElements": null,
      "updated": 1752973240447,
      "link": null,
      "locked": false,
      "text": "a software system that use LLM(s) to pursue goals and\ncomplete tasks on behalf of users. \n\nThey plan, reason, call tools, and rely on memory to complete\ncomplex tasks.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a software system that use LLM(s) to pursue goals and complete tasks on behalf of users. \n\nThey plan, reason, call tools, and rely on memory to complete complex tasks.",
      "autoResize": false,
      "lineHeight": 1.25
    },
