      "seed": 1847014219,
      "version": 1448,
      "versionNonce": 1499993035,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752974141902,
      "link": null,
      "locked": false,
      "text": "def get_forecast(lat, lon):\n    # Translate lat/lon to the right grid endpoint\n    points_url = f\"https://api.weather.gov/points/{lat},{lon}\"\n    resp = requests.get(points_url, headers=HEADERS, timeout=5)\n    resp.raise_for_status()\n    forecast_url = resp.json()[\"properties\"][\"forecast\"]\n\n    # Fetch the forecast itself\n    resp = requests.get(forecast_url, headers=HEADERS, timeout=5)\n    resp.raise_for_status()\n    return resp.json()",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def get_forecast(lat, lon):\n    # Translate lat/lon to the right grid endpoint\n    points_url = f\"https://api.weather.gov/points/{lat},{lon}\"\n    resp = requests.get(points_url, headers=HEADERS, timeout=5)\n    resp.raise_for_status()\n    forecast_url = resp.json()[\"properties\"][\"forecast\"]\n\n    # Fetch the forecast itself\n    resp = requests.get(forecast_url, headers=HEADERS, timeout=5)\n    resp.raise_for_status()\n    return resp.json()",
      "autoResize": true,
      "lineHeight": 1.25
    },
