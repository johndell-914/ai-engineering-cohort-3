      "link": null,
      "locked": false,
      "text": "Agents have autonomy. LLMs don't. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agents have autonomy. LLMs don't. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jeSSzy9e2hDrm9KLlfqu-",
      "type": "text",
      "x": 4964.4752116576465,
      "y": 1686.1806400859382,
      "width": 952.0993041992188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
