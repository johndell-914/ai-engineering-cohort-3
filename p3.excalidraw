    },
    {
      "id": "h_yxuS2mOfUuVoNLu7LMQ",
      "type": "text",
      "x": 4958.897016692845,
      "y": 6041.975588316145,
      "width": 532.7196044921875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
