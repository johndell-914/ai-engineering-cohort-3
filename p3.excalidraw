      "version": 206,
      "versionNonce": 517857483,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753047236461,
      "link": null,
      "locked": false,
      "text": "Primary responsibility: Examine the\noutput generated by the generator\nand identify issues.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Primary responsibility: Examine the output generated by the generator and identify issues.",
      "autoResize": false,
