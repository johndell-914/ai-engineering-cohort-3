      "seed": 1543398859,
      "version": 167,
      "versionNonce": 2006828357,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752971049917,
      "link": null,
      "locked": false,
      "text": "The agentic system is just a simple software that interacts with the LLM to answer to prompts.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The agentic system is just a simple software that interacts with the LLM to answer to prompts.",
      "autoResize": true,
      "lineHeight": 1.25
    },
