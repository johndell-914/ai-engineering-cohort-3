    {
      "id": "tQbHb9aUTWBXIWmNlq28V",
      "type": "text",
      "x": 10245.266552895157,
      "y": 2352.2058388986893,
      "width": 605.559326171875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
