      "index": "bmv",
      "roundness": null,
      "seed": 1800730667,
      "version": 198,
      "versionNonce": 546838955,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753047720138,
      "link": null,
      "locked": false,
      "text": "feedback loops:\n    - LLM generates a response\n    - LLM evaluates the response and provide feedback",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "feedback loops:\n    - LLM generates a response\n    - LLM evaluates the response and provide feedback",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "antKHjotHdiIWOEDGHy0K",
      "type": "text",
      "x": 7953.020052801756,
      "y": 6027.959963353398,
      "width": 449.419677734375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
