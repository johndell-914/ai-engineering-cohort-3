      "text": "maintain their own reflective text in an episodic\nmemory buffer to induce better decision-making in subsequent trials.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "maintain their own reflective text in an episodic\nmemory buffer to induce better decision-making in subsequent trials.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
