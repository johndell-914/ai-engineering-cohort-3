      "updated": 1752974420987,
      "link": null,
      "locked": false,
      "text": "LLMs are static. They generate output based on their\nstored parameters. \n\nThey don't have autonomy or agency to plan, perform\nactions, or break complex tasks in sub-tasks",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLMs are static. They generate output based on their stored parameters. \n\nThey don't have autonomy or agency to plan, perform actions, or break complex tasks in sub-tasks",
      "autoResize": false,
      "lineHeight": 1.25
    },
