      "link": null,
      "locked": false,
      "text": "Generator: A neural network that converts a random noise into an image.\nDiscriminator: Another neural network that determines whether a given image is real or artificially generated.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Generator: A neural network that converts a random noise into an image.\nDiscriminator: Another neural network that determines whether a given image is real or artificially generated.",
      "autoResize": true,
      "lineHeight": 1.25
    },
