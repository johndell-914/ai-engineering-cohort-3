    {
      "id": "tiQ5wlnPs1OGSgDinErdb",
      "type": "text",
      "x": 70.34787952482338,
      "y": 4820.193879183755,
      "width": 946.2593383789062,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTy",
      "roundness": null,
      "seed": 1468535549,
      "version": 344,
      "versionNonce": 1509173082,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751765047993,
      "link": null,
      "locked": false,
      "text": "For each training pair:\n\n    1. Noise addition: Randomly sample a timestep and use it to add noise to the input video.\n    2. Preparation of conditioning signals\n    3. Noise prediction: The model receives the noisy image as input and predicts the added noise\n    4. Loss calculation: MSE between the actual noise and the predicted noise\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For each training pair:\n\n    1. Noise addition: Randomly sample a timestep and use it to add noise to the input video.\n    2. Preparation of conditioning signals\n    3. Noise prediction: The model receives the noisy image as input and predicts the added noise\n    4. Loss calculation: MSE between the actual noise and the predicted noise\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
