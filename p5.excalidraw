    {
      "id": "CxTy1xm-GZX-vngsmVSBt",
      "type": "text",
      "x": 640.662585765974,
      "y": -326.7973480133061,
      "width": 1066.208089192708,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
